    "@types/chai": "^4.3.11",
    "@types/chai-as-promised": "^7.1.8",
    "@types/minimist": "^1.2.5",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "codecov": "^3.8.3",
    "dotenv": "^16.3.1",
    "elliptic": "^6.5.4",
    "eslint": "^9.39.1",
