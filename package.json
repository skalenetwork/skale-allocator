{
  "name": "@skalenetwork/skale-allocator",
  "description": "Contracts to manage tokens allocation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skalenetwork/skale-allocator.git"
  },
  "license": "AGPL-3.0",
  "author": "SKALE Labs",
  "contributors": [
    {
      "name": "Artem Payvin <artem.payvin@skalelabs.com>",
