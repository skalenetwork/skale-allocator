    "@skalenetwork/skale-contracts-ethers-v6": "^2.0.0-develop.6",
    "@typechain/ethers-v6": "^0.5.1",
    "@types/chai": "^4.3.11",
    "@types/chai-as-promised": "^7.1.8",
    "@types/minimist": "^1.2.5",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "axios": "^1.7.4",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.1",
