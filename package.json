    "@skalenetwork/skale-manager-interfaces": "1.0.0",
    "@skalenetwork/upgrade-tools": "^4.0.0-develop.3",
    "@typechain/hardhat": "^6.1.6",
    "axios": "^1.6.0",
    "chai": "^4.3.10",
