{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "target": "ES2020",
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types", "./typechain"],
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules"]
}
