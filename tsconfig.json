{
  "compilerOptions": {
    "module": "commonjs",
    "strict": true,
    "target": "es2020",
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types", "./typechain"],
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["node_modules"]
}
