{
  "compilerOptions": {
    "lib": ["ES2018", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "target": "es2020",
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types", "./typechain"],
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": [
    "typechain-output",
    "types-package"
  ]
}